-- Full development project: core plus the compressor add-ons, examples, and
-- benchmarks. Building everything needs system libraries (libbrotli, libzstd,
-- zlib headers). To build/test just the dependency-free core, use
-- cabal.project.core:
--
--   cabal build --project-file=cabal.project.core all
packages:
  .
  datastar-hs-zlib
  datastar-hs-brotli
  datastar-hs-zstd
  examples
  bench

constraints: memory < 0.18

-- hs-zstd: pinned to an unreleased commit with the streaming FFI binding
-- for flushStream; revert to Hackage once published.
--
-- https://github.com/starfederation/datastar-haskell/issues/3
source-repository-package
  type: git
  location: https://github.com/luispedro/hs-zstd
  tag: 59c0d21ab65a6296e06446c8368d78b9b4c7e64d
