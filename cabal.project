-- Full development project: core plus the compressor add-ons, examples, and
-- benchmarks. Building everything needs system libraries (libbrotli,
-- zlib headers). To build/test just the dependency-free core, use
-- cabal.project.core:
--
--   cabal build --project-file=cabal.project.core all
packages:
  .
  datastar-hs-zlib
  datastar-hs-brotli
  datastar-hs-zstd
  examples
  bench

constraints: memory < 0.18

-- Force the test suites into the build plan. By default the solver only
-- prefers them: when the newest release of a shared dependency is too new
-- for hspec (QuickCheck 2.19 was), it drops the test suites instead of
-- backtracking, and `cabal test` fails with Cabal-7043.
tests: True
